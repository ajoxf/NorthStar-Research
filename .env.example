# ---------------------------------------------------------------------------
# NorthStar Research — environment variables
#
# Copy to `.env.local` for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
#
# Anything still reading REPLACE_ME in production is NOT configured. The Cregis
# client and the notification providers deliberately throw a loud, explicit error
# rather than silently no-op'ing when they see a placeholder — a placeholder must
# never be mistaken for a working integration.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
# Public base URL of the deployment. Used for magic links, redemption emails,
# report links sent over email/WhatsApp, and Cregis success/cancel/callback URLs.
APP_BASE_URL=http://localhost:3000

# Secret used to sign session cookies and short-lived report URLs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_ME_AUTH_SECRET

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
CRON_SECRET=REPLACE_ME_CRON_SECRET

# --- Database (Postgres via the Neon integration in the Vercel Marketplace) ---
# Both names match what that integration injects into the Vercel project
# automatically, so nothing needs wiring by hand in production. Set them yourself
# only for local development, or if you provision Postgres somewhere else.
#
# Pooled connection, used by the app at runtime.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Direct (non-pooled) connection, used by Prisma Migrate only.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# --- File storage (Vercel Blob) -------------------------------------------
BLOB_READ_WRITE_TOKEN=REPLACE_ME_BLOB_TOKEN

# One-time secret enabling /admin/bootstrap, which creates the FIRST admin account
# from the browser. Unset = the page is inert. Delete this once your admin exists.
ADMIN_BOOTSTRAP_SECRET=

# --- Google sign-in (optional) --------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI must be exactly:
#   {APP_BASE_URL}/api/auth/google/callback
# Only the openid/email/profile scopes are used, so no Google app review is needed.
# Leave unset and the Google button simply does not appear on the sign-in page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (card subscriptions, $199/month, auto-renewing) ----------------
# STRIPE_PRICE_ID is a RECURRING monthly price of $199 — create it under
# Stripe → Product catalogue. A one-off price will not subscribe anyone.
# STRIPE_WEBHOOK_SECRET comes from the endpoint you register at
#   {APP_BASE_URL}/api/webhooks/stripe
# subscribed to: checkout.session.completed, invoice.paid,
#                customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
STRIPE_PRICE_ID=REPLACE_ME_STRIPE_PRICE_ID
STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET

# --- Cregis (crypto checkout) ---------------------------------------------
# Field names match the Cregis Developer Center dashboard.
# The client will paste real values straight into Vercel; leave these as
# placeholders in the repo.
CREGIS_PROJECT_ID=REPLACE_ME_PROJECT_ID
CREGIS_API_KEY=REPLACE_ME_API_KEY
CREGIS_BASE_URL=REPLACE_ME_BASE_URL

# Outbound static IP that Cregis will allowlist. Vercel serverless functions do
# NOT have a fixed outbound IP by default — see the note in src/lib/cregis.ts.
# This is an open pre-launch decision, not something this build resolves.
CREGIS_ALLOWLISTED_IP=REPLACE_ME

# --- Email delivery (Resend by default; swappable — see src/lib/notifications) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY
EMAIL_FROM="NorthStar Research <reports@example.com>"

# --- WhatsApp delivery (Twilio WhatsApp Business API by default) -----------
# Requires a verified business sender and pre-approved message templates.
# This is a separate signup with its own verification process.
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
# Pre-approved template SID for the "new report available" notification.
TWILIO_WHATSAPP_TEMPLATE_SID=REPLACE_ME_TEMPLATE_SID

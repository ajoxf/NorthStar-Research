// NordStar Pro — data model.
//
// This schema is deliberately CRM-shaped: a Member is not just an auth row, it is a
// contact with a subscription, contact channels, tags/notes for segmentation, and a
// queryable engagement history (DeliveryLog + ReportView).
//
// It is also deliberately ESP-friendly (see README "Portability"): email, names, tags
// and notes are plain first-class columns, not buried in opaque JSON, so they map
// directly onto how Kit.com and most ESPs model subscribers / tags / custom fields.

generator client {
  provider = "prisma-client-js"
}

// Variable names match what the Neon integration in the Vercel Marketplace injects into
// the project automatically, so no manual wiring is needed: DATABASE_URL is the pooled
// connection used at runtime, DATABASE_URL_UNPOOLED the direct one Prisma Migrate needs.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  member
  admin
}

enum SubscriptionStatus {
  pending
  active
  /// A free trial of the research membership, running now.
  ///
  /// Kept apart from `active` deliberately. A trialist has paid nothing, and counting them
  /// as active would overstate every revenue and conversion figure the members list is
  /// read for — and make a trial indistinguishable from a sale when the books are checked
  /// against what actually came in.
  ///
  /// Unlike `active`, this one is nothing without an end date: see isAllAccess.
  trialing
  expired
  cancelled
}

enum MemberSource {
  cregis_checkout
  stripe_checkout
  admin_manual
  import
  /// Signed up for a no-card free trial. Kept distinct from the checkout sources because
  /// a trialist has paid nothing: counting them as a crypto customer would overstate
  /// every conversion figure the members list is used to read.
  trial
}

/// How a member's recurring $199/month subscription is actually paid.
/// `stripe` renews itself; `cregis` is crypto and must be renewed by hand each period.
enum BillingProvider {
  stripe
  cregis
  manual
}

/// How often a package bills. Kept deliberately small: these two are the intervals
/// Stripe's recurring prices are configured for here, and an interval this app cannot
/// actually charge is worse than one it does not offer.
enum BillingInterval {
  month
  year
}

/// Who a section is priced for.
///
/// A label and a merchandising filter, never an access rule. A retail buyer cannot read an
/// institutional section because they hold no entitlement to that item — not because
/// anything here said no. Keeping it that way is the point: one access path, the one in
/// report-access.ts, and no second place where the answer to "can this person read this"
/// could come out differently.
enum Audience {
  /// Priced for an individual reading on their own account. Shown as "Starter" — the
  /// stored value stays `retail`; see src/lib/section-audience.ts.
  retail
  /// Priced for a desk. Usually the deeper work, usually the higher number.
  institutional
}

/// Whether a discount is an introductory offer or a standing price cut.
///
/// Stripe needs to know — it maps to a coupon's `once` or `forever` — and so does anyone
/// reading a renewal. The two are genuinely different promises: "25% off your first month"
/// and "25% off for as long as you stay" are the same first invoice and very different
/// businesses, and the thing that tells them apart must be stored rather than remembered.
enum OfferDuration {
  /// The first payment only.
  first_payment
  /// Every payment for as long as the subscription runs.
  forever
}

/// What kind of thing an Item is. The kind never changes what an entitlement *means* —
/// it is for grouping and for the admin's own sake.
enum ItemKind {
  /// A research section, written by an author.
  section
  /// A piece of software: Nexus RAMP, Spread Terminal, whatever follows.
  product
}

enum ReportType {
  commodities
  international_markets
  options_crypto_spread
  fx_currencies
}

enum CodeStatus {
  unused
  redeemed
}

/// Where an affiliate stands. Nothing is ever deleted — an affiliate who stops promoting
/// is `paused` (link keeps working for people who already have it, no new credit accrues)
/// or `closed` (link stops attributing). Their history stays either way.
enum AffiliateStatus {
  active
  paused
  closed
}

/// A referral's life. `visited` is a click that has not converted; `signed_up` a member
/// created under the code; `converted` a member who actually paid. Only `converted`
/// earns an award, because a signup that never pays is not a sale.
enum ReferralStatus {
  visited
  signed_up
  converted
}

/// How an affiliate is rewarded. `percent` of the first payment, `fixed` in USD, or
/// `free_months` of membership granted to the affiliate instead of money.
enum AffiliateRewardKind {
  percent
  fixed
  free_months
}

enum OrderStatus {
  pending
  paid
  failed
  expired
}

enum DeliveryChannel {
  email
  whatsapp
}

enum DeliveryStatus {
  queued
  sent
  delivered
  failed
  opened
  clicked
}

/// Which transactional message this was. Report sends are absent on purpose — those
/// already have DeliveryLog, which answers a different question (did *this member* get
/// *this report*) and would otherwise write hundreds of duplicate rows per publish.
enum EmailKind {
  welcome
  redemption_code
  receipt
  magic_link
  renewal_reminder
  sample_request
  /// Pricing sent to somebody who asked, from the enquiries screen.
  pricing_invite
  /// Warning that an unredeemed access code is about to stop working.
  code_expiring
  /// An operator's own probe from the admin console.
  test
}

/// What happened to one inbound provider callback.
///
/// The distinction that matters is between `rejected_signature` and nothing arriving at
/// all. Both leave the Opened column at zero and look identical from the admin, but one
/// means "Resend is not calling us" and the other means "Resend is calling and we are
/// turning it away" — completely different fixes, and guessing wrong costs an afternoon.
enum WebhookOutcome {
  /// Applied to a delivery log row.
  applied
  /// Verified, but nothing to apply it to — a welcome or receipt has no DeliveryLog row.
  unmatched
  /// Verified, but an older event than the one already recorded. Correctly discarded.
  stale
  /// An event type this app does not track. Acknowledged so the provider stops retrying.
  ignored
  /// Signature check failed. Either the secret is wrong, or it is not really the provider.
  rejected_signature
  /// No secret is set, so nothing can be verified and nothing is accepted.
  not_configured
  /// The body was not valid JSON.
  invalid_payload
}

/// Every inbound provider callback, and what became of it.
///
/// Deliberately bounded in what it stores: an outcome, an event type and a message id —
/// never the body. The payload carries recipient addresses and provider metadata, and a
/// log table is the wrong place for a copy of it.
model WebhookLog {
  id        String         @id @default(cuid())
  provider  String
  /// The provider's event name, e.g. `email.opened`. Empty when the body never parsed.
  eventType String?
  outcome   WebhookOutcome
  /// The provider's message id, when the event carried one.
  messageId String?
  /// One short line of context — never the payload.
  detail    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([provider, outcome])
}

/// Where a pricing enquiry has got to. Nothing is ever deleted — an enquiry that went
/// nowhere is still a record of somebody who asked.
enum EnquiryStatus {
  /// Asked, not yet sent anything.
  new
  /// Sent a private pricing link.
  invited
  /// Became a member.
  converted
  /// Deliberately set aside. Kept, not removed.
  closed
}

/// Somebody who asked what it costs.
///
/// Exists because the price is not on the public site: the join page takes an enquiry
/// instead, and the operator sends pricing individually. That makes this the top of the
/// funnel and the only record of demand the product has — so it captures contact details
/// properly rather than being a mail-to link that leaves nothing behind.
model PricingEnquiry {
  id    String @id @default(cuid())
  name  String
  email String

  /// Same two numbers as a member, asked the same way. A prospect who gives a WhatsApp
  /// number is reachable there before they are a member, which is the point of asking.
  phoneNumber    String?
  whatsappNumber String?

  /// Whatever they typed. Often what they actually want to know.
  note String?

  status EnquiryStatus @default(new)

  /// The unguessable half of the private pricing link. Not a credential — it reveals a
  /// price, nothing more — but random so a link cannot be enumerated from a sequence.
  inviteToken String    @unique
  invitedAt   DateTime?
  /// Set when a member appears with this email, so the funnel closes itself.
  convertedAt DateTime?

  /// Where they came from, when a referral cookie was set.
  referralSlug String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// Every transactional email the app tried to send, and what the provider said.
///
/// This exists because the failure it records was previously invisible. A welcome email
/// is sent fire-and-forget — deliberately, since a membership somebody paid for must not
/// fail because a greeting could not be sent — and its outcome went to `console.error`
/// and nowhere else. So "the client never got their email" had no answer anywhere in the
/// product: not in the admin, not in the database, and the Resend dashboard shows only
/// what was actually accepted, never what was never attempted.
///
/// The provider's own error text is stored verbatim. That string is the diagnosis —
/// "domain is not verified", "you can only send testing emails to your own address" —
/// and paraphrasing it into a friendly summary would throw away the one fact that
/// identifies which of several identical-looking failures this is.
model EmailLog {
  id      String    @id @default(cuid())
  kind    EmailKind
  toEmail String

  status            DeliveryStatus
  provider          String?
  providerMessageId String?
  error             String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model Member {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?

  firstName String?
  lastName  String?

  /// Mobile number. Captured at redemption, which every member passes through.
  phoneNumber      String?
  /// WhatsApp number, when it differs from the mobile — plenty of people run WhatsApp on
  /// a second line, and asking "WhatsApp *or* phone" got one number and no idea which it
  /// was. Null means WhatsApp is on the mobile above, or was not given.
  whatsappNumber   String?
  /// True once a WhatsApp number is known, whichever field it lives in.
  whatsappOptIn    Boolean @default(false)
  whatsappVerified Boolean @default(false)

  /// Set when the member signs in with Google. Null for password/magic-link accounts.
  googleId String? @unique

  role Role @default(member)

  subscriptionStatus    SubscriptionStatus @default(pending)
  subscriptionStartedAt DateTime?
  /// End of the paid period. Access is denied once this passes, whichever provider
  /// billed it — Stripe extends it automatically, Cregis renewals extend it by hand.
  subscriptionRenewsAt  DateTime?

  billingProvider       BillingProvider?
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?
  /// Stripe subscription set to stop at period end; access continues until then.
  cancelAtPeriodEnd     Boolean          @default(false)
  /// Guards against sending the same renewal reminder repeatedly.
  renewalReminderSentAt DateTime?

  /// When this account's free trial of the research membership began. Never cleared.
  ///
  /// One research trial per account, and it is judged on this having a value rather than
  /// on the status — an expired trial still counts, or the same account takes a free
  /// fortnight every month by waiting for the last one to lapse. The product trials are
  /// judged the same way, on whether an entitlement ever existed.
  researchTrialStartedAt DateTime?

  source MemberSource @default(cregis_checkout)

  // Flat string[] + free text: maps 1:1 onto ESP tags / custom fields on migration.
  /// Sections this member has bought, each with its own period and renewal.
  ///
  /// Empty for every member who exists today, and empty is the legacy all-access case —
  /// the access check reads the subscription fields above first and unchanged.
  entitlements Entitlement[]
  productAccounts ProductAccount[]

  tags       String[] @default([])
  adminNotes String?

  lastLoginAt        DateTime?
  lastReportViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What this member is subscribed to. Null for everyone who joined before packages
  /// existed, and for anyone comped by hand — both of which are still real members, so
  /// this cannot be required.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  redemptionCodes RedemptionCode[]
  reportViews     ReportView[]
  deliveryLogs    DeliveryLog[]
  reportsCreated  Report[]         @relation("ReportAuthor")
  appSettings     AppSetting[]

  /// Money-handling trails. An admin acts; the act is attributable for ever.
  refundsRecorded  Refund[]      @relation("RefundRecordedBy")
  ledgerWritten    LedgerEntry[] @relation("LedgerCreatedBy")
  payoutsRequested Payout[]      @relation("PayoutRequestedBy")
  payoutsApproved  Payout[]      @relation("PayoutApprovedBy")

  @@index([subscriptionStatus])
  @@index([createdAt])
}

model RedemptionCode {
  id              String     @id @default(cuid())
  code            String     @unique
  cregisOrderId   String?
  /// Email the code was *issued* to, when checkout captured one. Null for gifted codes.
  email           String?
  /// Operator's note on a gifted code — who it went to and why. Never an email address:
  /// it used to be written into `email`, which meant a gifted code carried a note where
  /// an address belonged and no redeemer was ever recorded against it.
  note            String?
  /// Email that actually redeemed the code. Always captured, however the code was issued,
  /// so every activation can be traced to a person without joining through Member.
  redeemedEmail   String?
  /// What this code represented commercially: 100 is free, 25 is a quarter off, 0 is full
  /// price. **Metadata only.** Redeeming any code grants the same membership period, and
  /// nothing here changes what a checkout charges — a discounted sale is settled however
  /// the operator settled it, and this records which offer it was so the codes list can be
  /// read as a campaign rather than as an undifferentiated pile of comps.
  discountPercent Int?
  status          CodeStatus @default(unused)

  redeemedByMemberId String?
  redeemedByMember   Member? @relation(fields: [redeemedByMemberId], references: [id])

  /// Which package this code grants. Carried from the order that paid for it, so the
  /// membership a buyer ends up with is the one they actually bought rather than
  /// whatever happens to be the default by the time they get round to redeeming.
  /// Null on gifted codes and on everything issued before packages existed — both fall
  /// back to the default package at redemption.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  /// Which section this code grants. Null grants the all-access membership, which is what
  /// every code issued so far does — so an unredeemed code minted before sections existed
  /// still means exactly what it meant when it was sent.
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  /// Codes stop working after this. Null means no expiry — codes issued before validity
  /// existed keep working, because retroactively killing a code already in someone's
  /// inbox is worse than an old code living on.
  expiresAt DateTime?

  /// How long the access this code grants runs for, decided when the code is minted:
  /// "this one is three months", "this one is a fortnight's trial".
  ///
  /// Null means "whatever the package says", which is what every code issued so far
  /// means — so outstanding codes keep granting exactly what they granted when they were
  /// sent. That is why this is not simply "null means forever": every code already in
  /// somebody's inbox would have turned into a lifetime membership on deploy.
  grantMonths Int?

  /// Open-ended access, with no renewal date — a comp. Deliberately its own field rather
  /// than a magic value in `grantMonths`, so that giving away permanent access is always
  /// something an operator ticked on purpose.
  grantsOpenEnded Boolean @default(false)

  /// When we warned the holder that this code was about to lapse.
  ///
  /// Cleared whenever the expiry is extended, so each expiry date warns once — the same
  /// shape as `Member.renewalReminderSentAt`. Without the reset, a code extended after a
  /// warning would sail silently into its new expiry, which is the one case where the
  /// holder has already shown they need the reminder.
  expiryReminderSentAt DateTime?

  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  @@index([status])
  @@index([expiresAt])
}

/// Someone who promotes the product in exchange for a reward.
///
/// Deliberately its own record rather than a flag on Member: an affiliate is often not a
/// member, and a member who becomes an affiliate must not have their membership tangled
/// with their payout terms. The two are linked when they happen to be the same person.
model Affiliate {
  id     String          @id @default(cuid())
  /// The bit that appears in a link: /join?ref=SLUG. Lowercase, URL-safe, never reused.
  slug   String          @unique
  name   String
  email  String
  status AffiliateStatus @default(active)

  /// Terms, captured per affiliate rather than globally so a deal can be struck with one
  /// partner without changing anyone else's.
  rewardKind   AffiliateRewardKind @default(percent)
  /// Percent (0–100), whole USD, or a number of months, depending on rewardKind.
  rewardAmount Int                 @default(20)

  /// Optional discount handed to the *visitor* — the other half of a referral deal.
  /// Percent off the first payment; 100 means free.
  visitorDiscountPercent Int?

  notes String?

  /// Set when the affiliate is also a member of the product.
  memberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals Referral[]
  awards    AffiliateAward[]

  @@index([status])
}

/// One person arriving through an affiliate link, and what became of them.
///
/// A row is created on the click, not on the sale, so the funnel is visible: clicks that
/// never convert are exactly what tells an operator a partner is sending the wrong
/// traffic. Nothing is deleted; a referral moves forward through its statuses.
model Referral {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id])
  status      ReferralStatus @default(visited)

  /// Anonymous until they sign up. Filled in as the referral progresses.
  email    String?
  memberId String?

  /// Amount actually paid, in whole USD, when the referral converts.
  amountUsd Int?

  visitedAt   DateTime  @default(now())
  signedUpAt  DateTime?
  convertedAt DateTime?

  awards AffiliateAward[]

  @@index([affiliateId, status])
  @@index([visitedAt])
}

/// What an affiliate has earned. A ledger, not a balance: rows are only ever added, so
/// the history of what was awarded and why survives any change to the affiliate's terms.
///
/// Payment happens outside this system — there is no payout processing here by design.
/// An award is marked settled by the operator once they have paid it their own way.
model AffiliateAward {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  referralId  String?
  referral    Referral? @relation(fields: [referralId], references: [id])

  kind   AffiliateRewardKind
  /// USD for percent/fixed awards; months for free_months.
  amount Int
  reason String?

  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([affiliateId, settledAt])
}

/// Mirrors a checkout order from either processor. Access is only ever granted from a
/// *verified* webhook transition of one of these rows to `paid` — never from a success
/// redirect, which anyone can visit without paying.
model CheckoutOrder {
  id            String          @id @default(cuid())
  /// Processor's own identifier: a Cregis order id, or a Stripe Checkout Session id.
  cregisOrderId String          @unique
  provider      BillingProvider @default(cregis)
  email         String
  phoneNumber   String?
  amount        String
  currency      String          @default("USD")
  status        OrderStatus     @default(pending)

  rawCallback Json?

  /// Which package was being bought. Null for orders placed before packages existed.
  /// The `amount` above stays the record of what was actually charged — a package whose
  /// price is edited later must not rewrite the history of what someone paid.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  /// Which section was bought, when the sale was a section rather than all-access.
  ///
  /// This is the field the author revenue share is computed from: a section has exactly
  /// one author, so a paid order carrying a section id is money owed to one person, with
  /// no split rule to agree. `amount` stays the record of what was charged, so editing a
  /// section's price later cannot rewrite what anybody actually paid.
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  /// The money facts this order's revenue share is computed from, in minor units.
  ///
  /// `amount` above stays the record of what was charged, as a string, exactly as it
  /// always was. These are additional and integer, because a share is arithmetic and
  /// arithmetic on a formatted string is how a ledger goes wrong quietly.
  ///
  /// All three are nullable and all three mean "not known", not "zero" — though the
  /// calculation treats them the same way for now. Tax and processor fees are not yet
  /// captured anywhere: there is no tax engine wired up, and neither webhook records what
  /// the processor kept. Until they are, net equals gross and the whole amount is shared,
  /// which is the honest behaviour rather than a convenient one. The columns exist so that
  /// turning either on later changes what the calculation is handed, not what it does.
  grossCents     Int?
  /// Collected for a tax authority. Held, never earned, and removed before any share.
  taxCents       Int?
  /// Kept by Stripe or Cregis.
  gatewayFeeCents Int?
  /// Owed to an introducing broker on this sale. See the IB note on AffiliateAward.
  ibFeeCents     Int?

  /// Which offer reduced this order, when one did.
  ///
  /// Recorded rather than recomputed. `amount` above is what was actually charged, and an
  /// offer that is later edited, expired or archived must not change the story of why a
  /// past order was for less than the list price — which is exactly what re-deriving the
  /// discount at read time would do. It is also what the redemption counter is reconciled
  /// against, so a miscount can be corrected from the orders rather than guessed at.
  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id])

  refunds Refund[]
  ledger  LedgerEntry[]

  /// The Stripe subscription this checkout created, when it was a card sale.
  ///
  /// Recorded so a section entitlement can be tied to its own subscription at redemption.
  /// One customer can now hold several subscriptions at once — all-access plus a section,
  /// or two sections — so the subscription, not the customer, is what identifies which
  /// thing a later invoice or cancellation is about.
  stripeSubscriptionId String?

  /// An operator's own live-mode probe, not a sale.
  ///
  /// This flag is load-bearing in the webhooks: a test order is acknowledged and recorded
  /// and then stops there — no redemption code, no member, no receipt, no affiliate
  /// credit. Without it, a $1 probe would mint a membership and email a stranger's
  /// address a code, which is the one thing a test must never do.
  isTest Boolean @default(false)

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

/// A sellable membership: a name, a price, and — for card buyers — the Stripe price it
/// maps onto.
///
/// The Stripe price id is the crux. Stripe charges whatever its own Price object says,
/// not what this row says, so a package advertising $299 against a $199 Stripe price
/// would show one figure and take another. `POST /api/admin/packages` therefore verifies
/// the pasted id against Stripe — amount, currency, interval and recurring-ness — and
/// refuses the save on any mismatch. Crypto packages need no such id: Cregis is told the
/// amount at checkout time, so the price here *is* the price charged.
///
/// Nothing is ever deleted. A package that any member or order has ever referenced is
/// archived (`archivedAt` set): it stops being sellable, and every record that points at
/// it still resolves. A package nothing has touched can be removed outright, because
/// there is no history to lose.
model Package {
  id          String  @id @default(cuid())
  name        String
  /// Stable, URL-safe handle. Used in the `?package=` link to /join, so it is what an
  /// operator shares — which is why renaming a package does not change it.
  slug        String  @unique
  /// One line under the name, on the join page.
  description String?

  /// Minor units, always. Storing 19900 rather than 199.00 keeps this in the same
  /// integer arithmetic Stripe uses and out of float rounding entirely.
  priceCents Int
  currency   String          @default("USD")
  interval   BillingInterval @default(month)

  /// The Stripe recurring Price this package sells. Required before card checkout will
  /// offer the package; crypto works without it.
  ///
  /// Normally created by this app when the price is set, rather than pasted: Stripe
  /// prices are immutable, so changing a price means creating a new one and pointing
  /// here at it. An operator may still paste an existing ID.
  stripePriceId String?

  /// The Stripe Product the prices above hang off. Reused across every price change so
  /// the Stripe dashboard shows one product with a price history, rather than a new
  /// product for every edit.
  stripeProductId String?

  /// Bullet points on the join page. Plain strings so they stay editable by hand.
  /// Push this package at members who do not hold it.
  ///
  /// Merchandising, not eligibility. What a member is *allowed* to trial is decided by
  /// overlap — holding any part of a bundle takes it off their list automatically — and
  /// that rule needs no operator. This is the separate question of whether the desk wants
  /// to put a given package in front of existing members at all, which only a person can
  /// answer: a bundle aimed at new buyers, or one being wound down, should not be
  /// suggested to somebody already subscribed to something else.
  ///
  /// Defaults to true so nothing changes on the day this ships. An operator turns off what
  /// they would rather not push, rather than having to turn on everything they would.
  ///
  /// It does not hide the package anywhere it is sold — the homepage, the contributor's
  /// page and checkout are unaffected. Only the suggestion inside the member portal.
  offerToMembers Boolean @default(true)

  /// The picture on this package's card — the thing a buyer sees before the price.
  ///
  /// Optional, like a section's. A package without one renders a typographic panel rather
  /// than a broken frame, so adding packages never waits on artwork.
  ///
  /// A Vercel Blob URL when uploaded here, but any https URL is accepted: a deployment
  /// with no Blob store configured can still set one, and an operator who already hosts
  /// their artwork should not have to re-upload it.
  imageUrl String?

  features String[] @default([])

  /// Low first on the join page. Ties break on name, so the order is never arbitrary.
  sortOrder Int @default(0)

  /// The one offered when nothing else is chosen — a bare /join, the marketing pages,
  /// a checkout with no package. Exactly one package holds this at a time.
  isDefault Boolean @default(false)

  /// Withdrawn from sale, still resolvable by everything that references it.
  archivedAt DateTime?

  /// Whose package this is, when it belongs to one contributor.
  ///
  /// **At most one author, deliberately** — the same constraint Section carries, for the
  /// same reason. A package attributed to one person makes the revenue share an
  /// attribution rather than a percentage split, and "everything by Dean" is a fact
  /// somebody can check rather than a formula somebody has to agree to.
  ///
  /// Null is the house package: the whole-site membership, which belongs to the desk
  /// rather than to any one contributor. Every package that existed before this column
  /// is null, which is why adding it changed nothing — the join page and the homepage
  /// read exactly the same rows they always did.
  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  /// Is a free trial of THIS package open, and for how long?
  ///
  /// Per package, alongside the same pair on Item, because the two answer different
  /// questions: a package trial opens everything in the bundle at once, on one end date,
  /// where an item trial opens a single section. An operator selling "Everything by Dean"
  /// wants to offer a fortnight of both his sections, not two trials that have to be
  /// started separately and lapse on different days.
  ///
  /// Off by default, and the default is load-bearing — a package created tomorrow must not
  /// arrive giving away a free fortnight nobody decided on.
  ///
  /// `trialDays` null means "use the house default", so changing that default moves every
  /// package that never had a number set of its own.
  trialEnabled Boolean @default(false)
  trialDays    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]
  orders  CheckoutOrder[]
  codes   RedemptionCode[]
  items   PackageItem[]
  offers  OfferPackage[]

  @@index([archivedAt, sortOrder])
  @@index([authorId, archivedAt])
}

/// A discount — a public sale, or one that needs a code.
///
/// **One model for both, because they differ in exactly one column.** A public sale applies
/// by itself and shows a reduced price wherever the thing is sold; a code applies only when
/// somebody enters it. Everything else about them — the percentage, the window, the scope,
/// the ceiling on redemptions, what happens at renewal — is identical, and two models would
/// have been two copies of the same pricing rules waiting to disagree.
///
/// **This never edits a price.** `Section.priceCents` and `Package.priceCents` stay the list
/// price and are not touched. The amount charged is computed at checkout from the list price
/// and whichever offer applies, so withdrawing a sale restores the real price by itself and
/// no campaign can leave a permanently altered price behind it.
model Offer {
  id String @id @default(cuid())
  /// What the desk calls it — "Launch week", "Q1 institutional". A campaign name, shown
  /// only in the admin; a buyer sees the percentage and the price, never this.
  name String

  /// Null is a public sale. A value is the code somebody has to type.
  ///
  /// Unique, so two campaigns cannot quietly claim the same string and leave which one
  /// applies up to row order.
  code String? @unique

  /// Whole percent off, 1–99.
  ///
  /// Not 100, and the exclusion is deliberate: a free subscription is a comp, and comps
  /// already have a mechanism in a gifted RedemptionCode, which grants with no payment at
  /// all. A 100% offer would send somebody to a checkout for nothing — an order neither
  /// Stripe nor Cregis can settle — so the one case that looks like a bigger discount is
  /// in fact a different operation.
  percentOff Int

  duration OfferDuration @default(first_payment)

  /// The window. A null start means live as soon as it exists; a null end means live until
  /// somebody archives it.
  startsAt DateTime?
  endsAt   DateTime?

  /// A ceiling on uses. Null is uncapped.
  ///
  /// **The count it is compared against is not stored here.** It is derived from paid
  /// CheckoutOrder rows carrying this offer, because a stored counter has to be
  /// incremented by a webhook — and webhooks are delivered more than once, so the counter
  /// would drift up on every retry and quietly close a campaign that had not sold out.
  /// Counting the orders is idempotent, is right even if a webhook is missed entirely,
  /// and is the same number anyone reconciling the books would arrive at.
  maxRedemptions Int?

  /// Does this apply to everything on sale?
  ///
  /// **An explicit flag rather than "no scope rows means everything".** That inference is
  /// exactly the shape of the empty-package bug — a package with no items granted
  /// all-access, so an operator who saved before ticking the contents gave away the site.
  /// Here the same inference would discount it. An offer with nothing selected and this
  /// off applies to nothing, which is the harmless way round.
  appliesToEverything Boolean @default(false)

  /// The Stripe Coupon this became. Created on first card use and reused after, the same
  /// way a package's Stripe Price is: coupons are immutable, so editing the percentage
  /// makes a new one and points here at it.
  stripeCouponId String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections OfferSection[]
  packages OfferPackage[]
  orders   CheckoutOrder[]

  @@index([archivedAt, startsAt, endsAt])
  @@index([code])
}

/// Which sections an offer is good for.
model OfferSection {
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  @@id([offerId, sectionId])
  @@index([sectionId])
}

/// Which packages an offer is good for.
model OfferPackage {
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  @@id([offerId, packageId])
  @@index([packageId])
}

/// Money given back to a buyer, recorded by an operator.
///
/// **Recorded here, not performed here.** Neither processor is refunded through this app:
/// an operator issues the refund in Stripe or sends the crypto back, then writes it down
/// so the ledger knows. Pretending otherwise would mean a button that claims to have moved
/// money it never touched.
///
/// Partial refunds are the normal case, not an edge one — a month of a year, a goodwill
/// gesture on a complaint — so the amount is stored rather than inferred from the order.
model Refund {
  id      String        @id @default(cuid())
  orderId String
  order   CheckoutOrder @relation(fields: [orderId], references: [id])

  /// Minor units, always positive. The direction lives in the ledger entry it writes.
  amountCents Int
  currency    String @default("USD")

  /// Why. Shown on the contributor's statement beside the reversal, because "your balance
  /// went down by $86" with no reason attached is the start of an argument.
  reason String?

  /// Who recorded it. An admin, not the buyer.
  recordedByMemberId String?
  recordedBy         Member? @relation("RefundRecordedBy", fields: [recordedByMemberId], references: [id])

  /// When the money actually went back, which may not be when it was typed in.
  refundedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  ledger LedgerEntry[]

  @@index([orderId])
  @@index([refundedAt])
}

/// What a ledger row is.
enum LedgerEntryKind {
  /// A share of a sale, credited to a contributor.
  earning
  /// A share given back because the sale was refunded.
  reversal
  /// A correction made by hand, in either direction.
  adjustment
  /// Money paid out, which reduces the balance.
  payout
}

/// Every movement on a contributor's account.
///
/// **Append-only, and that is the entire point.** Rows are added and never edited or
/// deleted, so a balance is a sum rather than a stored number somebody has to keep
/// correct, and the reason for every figure survives any change to the terms that produced
/// it. A correction is a new row, not an edit — which is why there is an `adjustment` kind
/// rather than an update path.
///
/// A contributor's balance is the sum of `amountCents`. What they can actually withdraw is
/// the sum of the rows whose `payableAt` has passed; see balanceOf in lib/earnings.ts.
model LedgerEntry {
  id       String          @id @default(cuid())
  authorId String
  author   Author          @relation(fields: [authorId], references: [id])
  kind     LedgerEntryKind

  /// Minor units. Positive credits the contributor, negative debits them.
  ///
  /// Signed rather than paired with a direction column, because every consumer wants the
  /// sum and a direction column means every one of them has to remember to apply it.
  amountCents Int
  currency    String @default("USD")

  /// When this becomes withdrawable. Null is immediately.
  ///
  /// Null on payouts, reversals and adjustments deliberately: a payout has already left,
  /// and a reversal that waited out a holdback would leave a balance claiming money that
  /// was refunded weeks earlier — precisely the balance somebody would withdraw against.
  payableAt DateTime?

  /// What produced this row. Exactly one is set for a machine-written entry; an
  /// adjustment typed by an operator has none of them.
  orderId  String?
  order    CheckoutOrder? @relation(fields: [orderId], references: [id])
  refundId String?
  refund   Refund?        @relation(fields: [refundId], references: [id])
  payoutId String?
  payout   Payout?        @relation(fields: [payoutId], references: [id])

  /// The terms this was computed under, snapshotted.
  ///
  /// Not read back from the Author, because that record changes. A statement from before a
  /// renegotiation has to still reconcile, and a refund has to take back what was actually
  /// given rather than what today's rate would have given.
  sharePercent Int?
  /// The net revenue the share was taken of, so a statement can show its working.
  basisCents   Int?

  /// An operator's words, for an adjustment or anything that needs explaining.
  note String?

  /// Who wrote it, when a person did. Null for entries posted by the system.
  createdByMemberId String?
  createdBy         Member? @relation("LedgerCreatedBy", fields: [createdByMemberId], references: [id])

  createdAt DateTime @default(now())

  /// One earning per order per author, so a replayed webhook cannot pay twice.
  ///
  /// Partial: a nullable orderId means refunds, payouts and adjustments are unaffected by
  /// it, while a second earning for the same sale is refused by the database rather than
  /// by whichever caller remembered to check.
  @@unique([orderId, authorId, kind])
  @@index([authorId, createdAt])
  @@index([authorId, payableAt])
}

/// How far along a withdrawal is.
enum PayoutStatus {
  /// Written down, waiting for someone to approve it.
  requested
  /// Approved, not yet sent.
  approved
  /// Turned down. Stays on the record with its reason.
  rejected
  /// Sent to the contributor through the gateway.
  sent
  /// Confirmed as arrived.
  settled
  /// Attempted and did not arrive.
  failed
}

/// A withdrawal of a contributor's balance.
///
/// **Approval is a separate act from the request, always.** Nothing moves on one person's
/// say-so in one step: a payout is written down, somebody looks at it, and only then can it
/// be marked sent. That ordering is enforced in the route rather than trusted to the
/// screen, because the screen is not what an API client talks to.
///
/// **Paying is still manual.** The gateway integration here collects money; whether it can
/// also disburse to a third party is an open question with the processor. So this records
/// the decision, the amount, the destination and the reference — and a human performs the
/// transfer. That is honest about where the boundary is, and the day the gateway grows a
/// payout API, only the "sent" step changes.
model Payout {
  id       String       @id @default(cuid())
  authorId String
  author   Author       @relation(fields: [authorId], references: [id])
  status   PayoutStatus @default(requested)

  /// Minor units, positive. The ledger entry it writes is the negative one.
  amountCents Int
  currency    String @default("USD")

  /// Where it is going. A wallet address, or a note naming another arrangement.
  ///
  /// Free text rather than a validated address: the gateway settles in crypto today, but
  /// a column that only accepts one chain's format would have to be migrated the first
  /// time that changes, and an operator pasting the wrong string is caught by the approval
  /// step rather than by a regular expression.
  destination String?

  requestedByMemberId String?
  requestedBy         Member?   @relation("PayoutRequestedBy", fields: [requestedByMemberId], references: [id])
  requestedAt         DateTime  @default(now())

  /// Who approved it, and when. Both null until somebody does.
  ///
  /// Recorded even when it is the same person who requested it. A one-person desk would be
  /// unable to pay anybody at all if a second approver were required, so the rule is that
  /// approval must *happen* and must be attributable — and a self-approved payout is
  /// labelled as one wherever it is shown, rather than being silently indistinguishable
  /// from one that two people saw.
  approvedByMemberId String?
  approvedBy         Member?   @relation("PayoutApprovedBy", fields: [approvedByMemberId], references: [id])
  approvedAt         DateTime?

  rejectedReason String?

  /// The processor's own identifier for the transfer, once there is one.
  externalReference String?

  sentAt    DateTime?
  settledAt DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger LedgerEntry[]

  @@index([authorId, status])
  @@index([status, requestedAt])
}

model Report {
  id          String      @id @default(cuid())
  /// Optional. The desk numbers its own editions in the title now, so new uploads carry
  /// no type. Kept nullable rather than dropped: reports published before this have a
  /// real type, the archive can still filter on it, and nothing is ever deleted.
  type        ReportType?
  title       String
  summary     String?
  publishDate DateTime

  pdfBlobUrl      String?
  pdfBlobPathname String?

  /// Responsive rendering used for the in-app reader and the (link-only) email view.
  htmlContent String?

  /// Structured rows behind the tabbed instrument table (see ReportInstrument in
  /// src/lib/report-content.ts). Kept as JSON because it is presentation data, not
  /// contact data — the ESP-portability rule applies to Member, not to report bodies.
  instruments Json?

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdByAdminId String?
  createdByAdmin   Member? @relation("ReportAuthor", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which section this edition belongs to, and therefore who can read it.
  ///
  /// Null on every report published before sections existed. That is not a gap to be
  /// backfilled away — an untagged report is an all-access report, readable by the
  /// members who bought all-access and by nobody who bought a single section. The desk
  /// tags what fits and leaves the rest.
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  views        ReportView[]
  deliveryLogs DeliveryLog[]
  /// One line written for sharing — the hook that makes somebody open the link.
  /// Distinct from `summary`, which is written for members who already subscribe.
  shareHook    String?

  @@index([type, publishDate])
  @@index([publishDate])
}

model ReportView {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id])
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  viewedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  signedTokenId String?
  downloaded    Boolean  @default(false)

  @@index([memberId, viewedAt])
  @@index([reportId])
}

model DeliveryLog {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  reportId String
  report   Report @relation(fields: [reportId], references: [id])

  channel DeliveryChannel
  status  DeliveryStatus  @default(queued)

  provider          String?
  providerMessageId String?
  error             String?

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@unique([memberId, reportId, channel])
  @@index([reportId])
  @@index([memberId])
}

/// A setting an operator can change from the admin console rather than from Vercel.
///
/// Values are stored ENCRYPTED (AES-256-GCM, key derived from AUTH_SECRET) because some
/// of them are credentials. See src/lib/secure-settings.ts for the reasoning and the
/// limits of what that protects against.
///
/// Deliberately narrow: only the settings listed in src/lib/cregis-settings.ts are ever
/// written here. This is not a general key-value store for the application.
model AppSetting {
  key   String @id
  /// Base64 of iv:ciphertext:tag. Never a plaintext credential.
  value String

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
  updatedByAdmin   Member?  @relation(fields: [updatedByAdminId], references: [id])
}

/// A subject the desk covers — Energy, Indices, Crypto.
///
/// Shared across authors on purpose. "Energy by Sarah" and "Energy by Tom" are two
/// products, but a visitor interested in energy wants to find both, and free text would
/// have made "Energy" and "Energy & Commodities" different subjects by accident.
///
/// Never deleted. `archivedAt` retires a topic from new sections while every section and
/// report already filed under it keeps working.
model Topic {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  /// One line under the topic name on the browse page. Optional.
  blurb     String?
  sortOrder Int     @default(0)

  /// Show this subject in the homepage's featured band.
  ///
  /// **False by default, and "none ticked" means "show them all."** The band used to be
  /// every topic with something on sale, which is right for three subjects and wrong for
  /// fifteen — but defaulting this to true would have been a migration that silently
  /// features everything, and defaulting to false without the fallback would empty the
  /// band on deploy for every site already running. The fallback is in `featuredTopics`,
  /// so the first tick is what turns the band from automatic into curated.
  featured  Boolean @default(false)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sections Section[]

  @@index([archivedAt, sortOrder])
}

/// An expert whose work is published here.
///
/// Deliberately NOT a login. An author is content — a name, a face, a biography and a
/// public page — and the desk publishes on their behalf. Giving outside contributors
/// accounts means a permission model, a way to reach the member list, and a review
/// process; none of that is needed to put someone's name and credentials on a report.
/// When author logins are wanted later they attach to this record rather than replacing it.
model Author {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// The one-line "who is this" that sits under the name. "Twenty years on the LME floor."
  headline    String?
  bio         String?
  photoUrl    String?
  /// Free-form lines — qualifications, prior desks, publications.
  credentials String[] @default([])

  /// Public profile links. Kept as plain columns rather than JSON so they can be validated.
  websiteUrl  String?
  linkedinUrl String?
  xUrl        String?

  /// Announce this person before their work is ready.
  ///
  /// Without it a contributor with no live section is not listed at all — a profile you
  /// cannot subscribe to is a dead end from a marketing page. This says "list them anyway,
  /// and say plainly that there is nothing to read yet", which is how a desk builds
  /// anticipation for somebody it has signed but not published.
  ///
  /// **It only shows while they genuinely have nothing on sale.** See comingSoonVisible:
  /// the announcement retires itself the moment their first subject goes live, so nobody
  /// has to remember to switch it off, and the site can never advertise a person as
  /// forthcoming on the same page it sells their work.
  comingSoon Boolean @default(false)

  /// Where this contributor sits on the homepage and in the contributors list.
  ///
  /// Alphabetical order is arbitrary as soon as there is a house desk among the names —
  /// the team that writes most of the archive should be able to lead without being
  /// renamed to sort first. Low first; ties fall back to the name, so the order is
  /// stable rather than whatever the database returns.
  sortOrder Int @default(0)

  /// This contributor's share of net revenue, as whole percent. Null uses the house
  /// default (see DEFAULT_SHARE_PERCENT).
  ///
  /// **Changing it does not rewrite history.** Every ledger entry stores the percentage it
  /// was computed at, so last quarter's statement still reconciles after a renegotiation —
  /// and a refund of an old sale takes back what was actually given rather than what
  /// today's terms would have given.
  revenueSharePercent Int?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sections Section[]
  /// The packages sold in this author's name. Empty for a contributor whose work is only
  /// sold section by section, or through the house membership.
  packages Package[]

  ledger  LedgerEntry[]
  payouts Payout[]

  @@index([archivedAt])
}

/// One topic, by one author — "Energy by Sarah Chen". The thing a member actually buys.
///
/// **Exactly one author.** That single constraint is what keeps the commercials simple:
/// every payment for a section belongs to one person, so the revenue share is an
/// attribution rather than a split, and no percentage has to be agreed, stored, or argued
/// about. Two experts covering energy is two sections, not one section with a 60/40 rule.
///
/// Price lives here rather than on Package: a section is its own product with its own
/// Stripe price. Package remains what it always was — the all-access plan — and is
/// untouched by any of this.
model Section {
  id          String  @id @default(cuid())
  slug        String  @unique
  /// Overrides the generated "Topic by Author" name when the desk wants something else.
  displayName String?
  description String?

  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id])
  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  /// The title image for this subject — the picture on its card and at the head of its
  /// page. Optional: a section without one falls back to a typographic panel rather than
  /// to a broken frame, so adding sections never waits on artwork.
  ///
  /// A Vercel Blob URL when uploaded here, but any https URL is accepted — a deployment
  /// with no Blob store configured can still set one, and an operator who already hosts
  /// their artwork should not have to re-upload it.
  imageUrl String?

  /// How often this subject publishes — "Daily", "Three times a week", "Every Monday".
  ///
  /// Per section rather than per site, because it is genuinely per section: one expert
  /// writes every morning and another writes a long piece on Fridays, and the site used
  /// to tell every buyer "three reports a week" regardless. That number was true of the
  /// desk when the desk was the only author.
  ///
  /// Free text rather than an enum, with presets offered in the admin. An expert who
  /// publishes "twice a month, plus event notes" should be able to say so; an enum would
  /// force that into the nearest wrong word, and a cadence is a promise to a buyer.
  ///
  /// Null means nothing is claimed, which is the honest default for a section nobody has
  /// set one on — better than inheriting a house figure that may not be true of it.
  cadence String?

  priceCents Int
  currency   String          @default("USD")
  interval   BillingInterval @default(month)

  /// Who this section is priced for. See the Audience enum: a label, never a gate.
  ///
  /// **Nullable rather than defaulted, deliberately.** A default would relabel every
  /// section already on sale the moment this deployed — and the build runs `prisma db
  /// push` against the live database, so "the moment this deployed" is not a figure of
  /// speech. Null means nobody has classified it yet: no badge in public, and a count in
  /// the admin so it does not stay that way by accident.
  audience Audience?

  /// Set once the section is wired to Stripe. Null means crypto-only, exactly like a
  /// package with no price id.
  stripePriceId   String?
  stripeProductId String?

  /// Off the shelf without being deleted — existing subscribers keep reading.
  archivedAt DateTime?
  sortOrder  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The grantable item this section is. One item per section, enforced by the database.
  /// Nullable only because a section created before its item would otherwise be
  /// unwritable; the backfill leaves none.
  itemId String? @unique
  item   Item?   @relation(fields: [itemId], references: [id])

  reports      Report[]
  entitlements Entitlement[]
  orders       CheckoutOrder[]
  codes        RedemptionCode[]
  offers       OfferSection[]

  /// One section per topic per author. A second "Energy by Sarah" is a mistake, not a product.
  @@unique([topicId, authorId])
  @@index([archivedAt, sortOrder])
}

/// One member's access to one section, with its own period and its own Stripe subscription.
///
/// This is the record that lets somebody hold Energy-by-Sarah and Crypto-by-Tom at once,
/// bought months apart and cancellable separately — which the Member table cannot express,
/// holding as it does a single renewal date and a single Stripe subscription.
///
/// Those Member fields are left exactly as they are. They now mean "the legacy all-access
/// membership", which is what every current member holds, and the access check reads them
/// first and unchanged. A member with no entitlements behaves today precisely as they did
/// before this table existed — that is the property that makes this safe to deploy to a
/// live site.
/// Anything a member can be granted access to.
///
/// Before this existed the answer to "what has this member bought?" had three shapes: the
/// legacy all-access fields on Member, an Entitlement pointing at a Section, and — once
/// software was sold — a third thing that would have needed its own column on Entitlement,
/// RedemptionCode and CheckoutOrder alike. Three tables carrying the same either/or, and
/// one more branch in every access check per product added.
///
/// An Item is the one shape underneath all of them. A research section is an item; Nexus
/// RAMP is an item; the fifth product will be an item. An entitlement points here, a
/// package grants a set of these, and the access check asks one question: does this member
/// hold a live entitlement to item X.
///
/// Nothing is stored here about what the item *is* — a Section keeps its price, author and
/// topic; a product will keep its own presentation fields. This row is only the handle that
/// access hangs off.
model Item {
  id   String   @id @default(cuid())
  kind ItemKind

  /// Stable handle, used in code and in the RAMP entitlement check ("nexus-ramp").
  /// Renaming the thing does not change it.
  slug String @unique
  /// What an operator sees in a list. Kept here so a package's contents read as names
  /// without joining out to two different tables depending on kind.
  name String

  /// Where a member actually opens this, for a product that lives on its own domain.
  /// Null for a research section, which is read here.
  url String?

  /// Withdrawn from sale; existing entitlements keep working, exactly as an archived
  /// package or section does.
  archivedAt DateTime?

  /// Is a free trial of THIS open, and for how long?
  ///
  /// Per item, because a trial is a fact about the thing being sold rather than a mode the
  /// whole site is in. These replace the three global trial.* settings, which could only
  /// ever describe one offer: turning on a trial of a second product closed the first.
  ///
  /// Off by default, and the default is load-bearing — a product created tomorrow must not
  /// arrive with a free trial nobody decided to give away. The existing global setting is
  /// carried onto its item once, on first read; see migrateLegacyTrialSettings.
  ///
  /// `trialDays` null means "use the house default", so changing that default moves every
  /// item that never had a number set of its own.
  trialEnabled Boolean @default(false)
  trialDays    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section      Section?
  entitlements Entitlement[]
  packages     PackageItem[]
  accounts     ProductAccount[]

  @@index([kind, archivedAt])
}

/// Which items a package grants.
///
/// This is what makes a bundle a bundle: "Research + RAMP" is a package with four items
/// ticked rather than a new kind of object. Redeeming or buying the package creates one
/// entitlement per item, all sharing that subscription's period, so they begin and lapse
/// together.
model PackageItem {
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())

  @@id([packageId, itemId])
  @@index([itemId])
}

model Entitlement {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  /// The section this grants, for every row written before items existed.
  ///
  /// Being retired in favour of `itemId`: the backfill gives every row an item, new writes
  /// set both, and this column goes once nothing reads it. Both are nullable in the
  /// meantime because a half-migrated table with a NOT NULL on either is a table that
  /// cannot be half-migrated.
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  /// What this entitlement actually grants. A research section, a product — the access
  /// check does not care which.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  status            SubscriptionStatus @default(pending)
  startedAt         DateTime?
  /// End of the paid period. Null means open-ended — a comp, granted by hand.
  renewsAt          DateTime?
  cancelAtPeriodEnd Boolean            @default(false)

  billingProvider      BillingProvider?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per member per section; renewing updates it rather than adding another.
  @@unique([memberId, sectionId])
  /// One row per member per item; renewing updates it rather than adding another. This is
  /// what stops a second grant of the same product creating a duplicate instead of
  /// extending what is there.
  ///
  /// Created by hand first (scripts/sql/002-item-unique-indexes.sql) and declared here
  /// afterwards, because the build runs `prisma db push` without `--accept-data-loss` and
  /// Prisma treats adding a unique constraint as a change that could fail on existing
  /// rows. With the index already in place this declaration is a no-op at deploy time.
  @@unique([memberId, itemId])
  @@index([status, renewsAt])
  @@index([sectionId])
  @@index([itemId])
}

/// A member's account in a product's own sign-in system.
///
/// Nexus RAMP authenticates with Supabase and knows nothing about this site. Rather than
/// rebuild its sign-in — the desk uses it daily and it works — the portal creates the
/// account there when it grants the entitlement, with the email and password the person
/// just chose here. One set of credentials, two sites, and RAMP unchanged.
///
/// `externalId` is that system's own id for the user, kept so a later password change or
/// a revocation addresses the right account without having to search by email.
model ProductAccount {
  id       String @id @default(cuid())
  memberId String
  itemId   String

  /// The id in the product's auth system. Supabase's user uuid, for RAMP.
  externalId String

  /// Set when access was withdrawn — the entitlement lapsed, or the desk revoked it.
  /// The account is disabled there rather than deleted, so the person's own data
  /// survives a renewal.
  disabledAt DateTime?

  /// Set when the account already existed in the product and was linked rather than
  /// created. Their password there stays theirs — overwriting it would mean anyone who
  /// knows an email address could take over that account by starting a trial — so the
  /// portal has to tell them their two passwords are different.
  adoptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([memberId, itemId])
  @@index([itemId])
}

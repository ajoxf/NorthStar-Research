// NordStar Pro — data model.
//
// This schema is deliberately CRM-shaped: a Member is not just an auth row, it is a
// contact with a subscription, contact channels, tags/notes for segmentation, and a
// queryable engagement history (DeliveryLog + ReportView).
//
// It is also deliberately ESP-friendly (see README "Portability"): email, names, tags
// and notes are plain first-class columns, not buried in opaque JSON, so they map
// directly onto how Kit.com and most ESPs model subscribers / tags / custom fields.

generator client {
  provider = "prisma-client-js"
}

// Variable names match what the Neon integration in the Vercel Marketplace injects into
// the project automatically, so no manual wiring is needed: DATABASE_URL is the pooled
// connection used at runtime, DATABASE_URL_UNPOOLED the direct one Prisma Migrate needs.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  member
  admin
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum MemberSource {
  cregis_checkout
  stripe_checkout
  admin_manual
  import
}

/// How a member's recurring $199/month subscription is actually paid.
/// `stripe` renews itself; `cregis` is crypto and must be renewed by hand each period.
enum BillingProvider {
  stripe
  cregis
  manual
}

/// How often a package bills. Kept deliberately small: these two are the intervals
/// Stripe's recurring prices are configured for here, and an interval this app cannot
/// actually charge is worse than one it does not offer.
enum BillingInterval {
  month
  year
}

enum ReportType {
  commodities
  international_markets
  options_crypto_spread
  fx_currencies
}

enum CodeStatus {
  unused
  redeemed
}

/// Where an affiliate stands. Nothing is ever deleted — an affiliate who stops promoting
/// is `paused` (link keeps working for people who already have it, no new credit accrues)
/// or `closed` (link stops attributing). Their history stays either way.
enum AffiliateStatus {
  active
  paused
  closed
}

/// A referral's life. `visited` is a click that has not converted; `signed_up` a member
/// created under the code; `converted` a member who actually paid. Only `converted`
/// earns an award, because a signup that never pays is not a sale.
enum ReferralStatus {
  visited
  signed_up
  converted
}

/// How an affiliate is rewarded. `percent` of the first payment, `fixed` in USD, or
/// `free_months` of membership granted to the affiliate instead of money.
enum AffiliateRewardKind {
  percent
  fixed
  free_months
}

enum OrderStatus {
  pending
  paid
  failed
  expired
}

enum DeliveryChannel {
  email
  whatsapp
}

enum DeliveryStatus {
  queued
  sent
  delivered
  failed
  opened
  clicked
}

/// Which transactional message this was. Report sends are absent on purpose — those
/// already have DeliveryLog, which answers a different question (did *this member* get
/// *this report*) and would otherwise write hundreds of duplicate rows per publish.
enum EmailKind {
  welcome
  redemption_code
  receipt
  magic_link
  renewal_reminder
  sample_request
  /// An operator's own probe from the admin console.
  test
}

/// What happened to one inbound provider callback.
///
/// The distinction that matters is between `rejected_signature` and nothing arriving at
/// all. Both leave the Opened column at zero and look identical from the admin, but one
/// means "Resend is not calling us" and the other means "Resend is calling and we are
/// turning it away" — completely different fixes, and guessing wrong costs an afternoon.
enum WebhookOutcome {
  /// Applied to a delivery log row.
  applied
  /// Verified, but nothing to apply it to — a welcome or receipt has no DeliveryLog row.
  unmatched
  /// Verified, but an older event than the one already recorded. Correctly discarded.
  stale
  /// An event type this app does not track. Acknowledged so the provider stops retrying.
  ignored
  /// Signature check failed. Either the secret is wrong, or it is not really the provider.
  rejected_signature
  /// No secret is set, so nothing can be verified and nothing is accepted.
  not_configured
  /// The body was not valid JSON.
  invalid_payload
}

/// Every inbound provider callback, and what became of it.
///
/// Deliberately bounded in what it stores: an outcome, an event type and a message id —
/// never the body. The payload carries recipient addresses and provider metadata, and a
/// log table is the wrong place for a copy of it.
model WebhookLog {
  id       String         @id @default(cuid())
  provider String
  /// The provider's event name, e.g. `email.opened`. Empty when the body never parsed.
  eventType String?
  outcome  WebhookOutcome
  /// The provider's message id, when the event carried one.
  messageId String?
  /// One short line of context — never the payload.
  detail   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([provider, outcome])
}

/// Every transactional email the app tried to send, and what the provider said.
///
/// This exists because the failure it records was previously invisible. A welcome email
/// is sent fire-and-forget — deliberately, since a membership somebody paid for must not
/// fail because a greeting could not be sent — and its outcome went to `console.error`
/// and nowhere else. So "the client never got their email" had no answer anywhere in the
/// product: not in the admin, not in the database, and the Resend dashboard shows only
/// what was actually accepted, never what was never attempted.
///
/// The provider's own error text is stored verbatim. That string is the diagnosis —
/// "domain is not verified", "you can only send testing emails to your own address" —
/// and paraphrasing it into a friendly summary would throw away the one fact that
/// identifies which of several identical-looking failures this is.
model EmailLog {
  id      String    @id @default(cuid())
  kind    EmailKind
  toEmail String

  status            DeliveryStatus
  provider          String?
  providerMessageId String?
  error             String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model Member {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?

  firstName String?
  lastName  String?

  phoneNumber      String?
  whatsappOptIn    Boolean @default(false)
  whatsappVerified Boolean @default(false)

  /// Set when the member signs in with Google. Null for password/magic-link accounts.
  googleId String? @unique

  role Role @default(member)

  subscriptionStatus    SubscriptionStatus @default(pending)
  subscriptionStartedAt DateTime?
  /// End of the paid period. Access is denied once this passes, whichever provider
  /// billed it — Stripe extends it automatically, Cregis renewals extend it by hand.
  subscriptionRenewsAt  DateTime?

  billingProvider       BillingProvider?
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?
  /// Stripe subscription set to stop at period end; access continues until then.
  cancelAtPeriodEnd     Boolean          @default(false)
  /// Guards against sending the same renewal reminder repeatedly.
  renewalReminderSentAt DateTime?

  source MemberSource @default(cregis_checkout)

  // Flat string[] + free text: maps 1:1 onto ESP tags / custom fields on migration.
  tags       String[] @default([])
  adminNotes String?

  lastLoginAt        DateTime?
  lastReportViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What this member is subscribed to. Null for everyone who joined before packages
  /// existed, and for anyone comped by hand — both of which are still real members, so
  /// this cannot be required.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  redemptionCodes RedemptionCode[]
  reportViews     ReportView[]
  deliveryLogs    DeliveryLog[]
  reportsCreated  Report[]         @relation("ReportAuthor")

  @@index([subscriptionStatus])
  @@index([createdAt])
  appSettings AppSetting[]
}

model RedemptionCode {
  id              String     @id @default(cuid())
  code            String     @unique
  cregisOrderId   String?
  /// Email the code was *issued* to, when checkout captured one. Null for gifted codes.
  email           String?
  /// Operator's note on a gifted code — who it went to and why. Never an email address:
  /// it used to be written into `email`, which meant a gifted code carried a note where
  /// an address belonged and no redeemer was ever recorded against it.
  note            String?
  /// Email that actually redeemed the code. Always captured, however the code was issued,
  /// so every activation can be traced to a person without joining through Member.
  redeemedEmail   String?
  /// What this code represented commercially: 100 is free, 25 is a quarter off, 0 is full
  /// price. **Metadata only.** Redeeming any code grants the same membership period, and
  /// nothing here changes what a checkout charges — a discounted sale is settled however
  /// the operator settled it, and this records which offer it was so the codes list can be
  /// read as a campaign rather than as an undifferentiated pile of comps.
  discountPercent Int?
  status          CodeStatus @default(unused)

  redeemedByMemberId String?
  redeemedByMember   Member? @relation(fields: [redeemedByMemberId], references: [id])

  /// Which package this code grants. Carried from the order that paid for it, so the
  /// membership a buyer ends up with is the one they actually bought rather than
  /// whatever happens to be the default by the time they get round to redeeming.
  /// Null on gifted codes and on everything issued before packages existed — both fall
  /// back to the default package at redemption.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  /// Codes stop working after this. Null means no expiry — codes issued before validity
  /// existed keep working, because retroactively killing a code already in someone's
  /// inbox is worse than an old code living on.
  expiresAt DateTime?

  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  @@index([status])
  @@index([expiresAt])
}

/// Someone who promotes the product in exchange for a reward.
///
/// Deliberately its own record rather than a flag on Member: an affiliate is often not a
/// member, and a member who becomes an affiliate must not have their membership tangled
/// with their payout terms. The two are linked when they happen to be the same person.
model Affiliate {
  id     String          @id @default(cuid())
  /// The bit that appears in a link: /join?ref=SLUG. Lowercase, URL-safe, never reused.
  slug   String          @unique
  name   String
  email  String
  status AffiliateStatus @default(active)

  /// Terms, captured per affiliate rather than globally so a deal can be struck with one
  /// partner without changing anyone else's.
  rewardKind   AffiliateRewardKind @default(percent)
  /// Percent (0–100), whole USD, or a number of months, depending on rewardKind.
  rewardAmount Int                 @default(20)

  /// Optional discount handed to the *visitor* — the other half of a referral deal.
  /// Percent off the first payment; 100 means free.
  visitorDiscountPercent Int?

  notes String?

  /// Set when the affiliate is also a member of the product.
  memberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals Referral[]
  awards    AffiliateAward[]

  @@index([status])
}

/// One person arriving through an affiliate link, and what became of them.
///
/// A row is created on the click, not on the sale, so the funnel is visible: clicks that
/// never convert are exactly what tells an operator a partner is sending the wrong
/// traffic. Nothing is deleted; a referral moves forward through its statuses.
model Referral {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id])
  status      ReferralStatus @default(visited)

  /// Anonymous until they sign up. Filled in as the referral progresses.
  email    String?
  memberId String?

  /// Amount actually paid, in whole USD, when the referral converts.
  amountUsd Int?

  visitedAt   DateTime  @default(now())
  signedUpAt  DateTime?
  convertedAt DateTime?

  awards AffiliateAward[]

  @@index([affiliateId, status])
  @@index([visitedAt])
}

/// What an affiliate has earned. A ledger, not a balance: rows are only ever added, so
/// the history of what was awarded and why survives any change to the affiliate's terms.
///
/// Payment happens outside this system — there is no payout processing here by design.
/// An award is marked settled by the operator once they have paid it their own way.
model AffiliateAward {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  referralId  String?
  referral    Referral? @relation(fields: [referralId], references: [id])

  kind   AffiliateRewardKind
  /// USD for percent/fixed awards; months for free_months.
  amount Int
  reason String?

  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([affiliateId, settledAt])
}

/// Mirrors a checkout order from either processor. Access is only ever granted from a
/// *verified* webhook transition of one of these rows to `paid` — never from a success
/// redirect, which anyone can visit without paying.
model CheckoutOrder {
  id            String          @id @default(cuid())
  /// Processor's own identifier: a Cregis order id, or a Stripe Checkout Session id.
  cregisOrderId String          @unique
  provider      BillingProvider @default(cregis)
  email         String
  phoneNumber   String?
  amount        String
  currency      String          @default("USD")
  status        OrderStatus     @default(pending)

  rawCallback Json?

  /// Which package was being bought. Null for orders placed before packages existed.
  /// The `amount` above stays the record of what was actually charged — a package whose
  /// price is edited later must not rewrite the history of what someone paid.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  /// An operator's own live-mode probe, not a sale.
  ///
  /// This flag is load-bearing in the webhooks: a test order is acknowledged and recorded
  /// and then stops there — no redemption code, no member, no receipt, no affiliate
  /// credit. Without it, a $1 probe would mint a membership and email a stranger's
  /// address a code, which is the one thing a test must never do.
  isTest Boolean @default(false)

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

/// A sellable membership: a name, a price, and — for card buyers — the Stripe price it
/// maps onto.
///
/// The Stripe price id is the crux. Stripe charges whatever its own Price object says,
/// not what this row says, so a package advertising $299 against a $199 Stripe price
/// would show one figure and take another. `POST /api/admin/packages` therefore verifies
/// the pasted id against Stripe — amount, currency, interval and recurring-ness — and
/// refuses the save on any mismatch. Crypto packages need no such id: Cregis is told the
/// amount at checkout time, so the price here *is* the price charged.
///
/// Nothing is ever deleted. A package that any member or order has ever referenced is
/// archived (`archivedAt` set): it stops being sellable, and every record that points at
/// it still resolves. A package nothing has touched can be removed outright, because
/// there is no history to lose.
model Package {
  id          String  @id @default(cuid())
  name        String
  /// Stable, URL-safe handle. Used in the `?package=` link to /join, so it is what an
  /// operator shares — which is why renaming a package does not change it.
  slug        String  @unique
  /// One line under the name, on the join page.
  description String?

  /// Minor units, always. Storing 19900 rather than 199.00 keeps this in the same
  /// integer arithmetic Stripe uses and out of float rounding entirely.
  priceCents Int
  currency   String          @default("USD")
  interval   BillingInterval @default(month)

  /// The Stripe recurring Price this package sells. Required before card checkout will
  /// offer the package; crypto works without it.
  ///
  /// Normally created by this app when the price is set, rather than pasted: Stripe
  /// prices are immutable, so changing a price means creating a new one and pointing
  /// here at it. An operator may still paste an existing ID.
  stripePriceId String?

  /// The Stripe Product the prices above hang off. Reused across every price change so
  /// the Stripe dashboard shows one product with a price history, rather than a new
  /// product for every edit.
  stripeProductId String?

  /// Bullet points on the join page. Plain strings so they stay editable by hand.
  features String[] @default([])

  /// Low first on the join page. Ties break on name, so the order is never arbitrary.
  sortOrder Int @default(0)

  /// The one offered when nothing else is chosen — a bare /join, the marketing pages,
  /// a checkout with no package. Exactly one package holds this at a time.
  isDefault Boolean @default(false)

  /// Withdrawn from sale, still resolvable by everything that references it.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]
  orders  CheckoutOrder[]
  codes   RedemptionCode[]

  @@index([archivedAt, sortOrder])
}

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  title       String
  summary     String?
  publishDate DateTime

  pdfBlobUrl      String?
  pdfBlobPathname String?

  /// Responsive rendering used for the in-app reader and the (link-only) email view.
  htmlContent String?

  /// Structured rows behind the tabbed instrument table (see ReportInstrument in
  /// src/lib/report-content.ts). Kept as JSON because it is presentation data, not
  /// contact data — the ESP-portability rule applies to Member, not to report bodies.
  instruments Json?

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdByAdminId String?
  createdByAdmin   Member? @relation("ReportAuthor", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views        ReportView[]
  deliveryLogs DeliveryLog[]

  @@index([type, publishDate])
  @@index([publishDate])
  /// One line written for sharing — the hook that makes somebody open the link.
  /// Distinct from `summary`, which is written for members who already subscribe.
  shareHook String?

}

model ReportView {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id])
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  viewedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  signedTokenId String?
  downloaded    Boolean  @default(false)

  @@index([memberId, viewedAt])
  @@index([reportId])
}

model DeliveryLog {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  reportId String
  report   Report @relation(fields: [reportId], references: [id])

  channel DeliveryChannel
  status  DeliveryStatus  @default(queued)

  provider          String?
  providerMessageId String?
  error             String?

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@unique([memberId, reportId, channel])
  @@index([reportId])
  @@index([memberId])
}

/// A setting an operator can change from the admin console rather than from Vercel.
///
/// Values are stored ENCRYPTED (AES-256-GCM, key derived from AUTH_SECRET) because some
/// of them are credentials. See src/lib/secure-settings.ts for the reasoning and the
/// limits of what that protects against.
///
/// Deliberately narrow: only the settings listed in src/lib/cregis-settings.ts are ever
/// written here. This is not a general key-value store for the application.
model AppSetting {
  key   String @id
  /// Base64 of iv:ciphertext:tag. Never a plaintext credential.
  value String

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
  updatedByAdmin   Member?  @relation(fields: [updatedByAdminId], references: [id])
}
